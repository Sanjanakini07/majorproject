# start.bat copies this file to .env for you. Fill in the empty settings. Never commit .env.

# --- Google sign-in through Firebase (see README, "The settings") ---
# Firebase console > Project settings > General > Your apps > Web app: apiKey and projectId.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
ALLOWED_DOMAIN=nmamit.in
# The address you open in the browser.
BASE_URL=http://localhost:8000

# --- Admins: comma-separated college emails ---
ADMIN_EMAILS=

# --- Sessions ---
# Leave empty: start.bat (scripts/check_setup.py) fills in a strong random key.
SECRET_KEY=
# Set to true when the site is served over https.
HTTPS_ONLY=false

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current model names.
GROQ_MODEL=openai/gpt-oss-120b

# --- Face check (optional tuning) ---
# Higher = stricter. 0.363 is OpenCV's recommended value for the SFace model.
FACE_MATCH_THRESHOLD=0.363
FACE_MAX_FAILURES=5
FACE_LOCK_MINUTES=10

# --- Search tuning (optional) ---
# How many pieces of knowledge to give the AI, and how close they must be (0 = same, 1 = unrelated).
TOP_K=4
MAX_DISTANCE=0.7

# --- Offline app (start_offline.bat) ---
# Turso backend the laptop syncs with when it has internet. Leave both empty to stay offline only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Seconds between sync tries.
SYNC_SECONDS=60
# Local AI model (Ollama). Bigger is smarter but slower, e.g. qwen2.5:3b or llama3.2:3b.
OLLAMA_MODEL=qwen2.5:1.5b
# Speech-to-text model: tiny.en (fastest), base.en, small.en (most accurate).
WHISPER_MODEL=base.en
